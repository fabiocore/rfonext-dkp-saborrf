# Copie para ".env" na raiz do projeto (mesma pasta do docker-compose.prod.yml)
# antes de subir em produção. Nunca commitar o ".env" de verdade.

POSTGRES_USER=rfonext
POSTGRES_PASSWORD=troque-esta-senha-por-uma-forte
POSTGRES_DB=rfonext_dkp

# Gere um valor longo e aleatório (ex: openssl rand -hex 32). Trocar isso
# depois do deploy invalida todos os logins ativos.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=12h

# Usados só na primeiríssima subida, pra criar a conta de GM (PREMISSAS.md
# seção 8). Troque a senha pelo painel assim que logar a primeira vez.
GM_BOOTSTRAP_USERNAME=guildmaster
GM_BOOTSTRAP_PASSWORD=troque-esta-senha-no-primeiro-login
